# ========================================================
# DentaCare Stomatologiya - Namuna Sozlamalar (.env.example)
# ========================================================

# 1. Asosiy Server Sozlamalari
PORT=3000
NODE_ENV=production

# 2. PostgreSQL Ma'lumotlar Bazasi (Render yoki tashqi bulutli PostgreSQL uchun)
# Render Managed PostgreSQL yaratilganda beriladigan 'Internal' yoki 'External' Connection String:
DATABASE_URL=postgresql://dentacare_user:password@dpg-xxxxxx-a.frankfurt-postgres.render.com/dentacare
DATABASE_SSL=true

# Mahalliy Docker yoki PostgreSQL uchun parametrlar (DATABASE_URL bo'lmaganda):
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=dentacare

# 3. Frontend Expo Web API Manzili
# Agar alohida static sayt qilinsa: Render backend domeni (masalan: https://dentacare-app.onrender.com)
# Mahalliy planshet va kompyuterlar uchun LAN IP (masalan: http://192.168.1.18:3000)
# Yagona Render xizmatida bo'lsa bo'sh qoldirish mumkin (avtomatik bir xil domen ishlatiladi):
EXPO_PUBLIC_API_URL=

# 4. Eskiz.uz SMS Provayderi (Ixtiyoriy)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# 5. Telegram Bot Sozlamalari (Ixtiyoriy)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
